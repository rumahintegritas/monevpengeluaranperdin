<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoring Pengeluaran Perjalanan Dinas</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">
        <header class="mb-4 text-center">
            <h2 class="fw-bold text-primary"><i class="fas fa-wallet me-2"></i>Monitoring Pengeluaran Perjalanan Dinas</h2>
            <p class="text-muted">Catat uang muka bendahara dan pantau pengeluaran secara real-time</p>
        </header>

        <!-- Ringkasan / Rekapan -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title text-uppercase mb-1">Uang Muka Bendahara</h6>
                                <h3 id="labelUangMuka" class="fw-bold mb-0">Rp 0</h3>
                            </div>
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-light text-info fw-bold" data-bs-toggle="modal" data-bs-target="#modalTambahUangMuka" title="Tambah Uang Muka">
                                    <i class="fas fa-plus"></i> Tambah
                                </button>
                                <button class="btn btn-sm btn-outline-light fw-bold" data-bs-toggle="modal" data-bs-target="#modalUangMuka" title="Atur Uang Muka">
                                    <i class="fas fa-edit"></i> Atur
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title text-uppercase mb-1">Total Pengeluaran</h6>
                        <h3 id="totalPengeluaran" class="fw-bold mb-0">Rp 0</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0" id="cardSisaContainer">
                    <div class="card-body" id="cardSisaBody">
                        <h6 class="card-title text-uppercase mb-1" id="labelSisaTitle">Sisa / Kurang Bayar</h6>
                        <h3 id="sisaSaldo" class="fw-bold mb-0">Rp 0</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Form Input Pengeluaran -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-plus-circle me-2 text-primary"></i>Tambah Pengeluaran</h5>
                    </div>
                    <div class="card-body">
                        <form id="formDinas">
                            <div class="mb-3">
                                <label class="form-label">Tanggal</label>
                                <input type="date" class="form-control" id="tanggal" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kota Tujuan</label>
                                <input type="text" class="form-control" id="kota" placeholder="Contoh: Bandung" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kategori</label>
                                <select class="form-select" id="kategori" required>
                                    <option value="">Pilih Kategori...</option>
                                    <option value="Transportasi">Transportasi (Tiket/BBM)</option>
                                    <option value="Penginapan">Penginapan / Hotel</option>
                                    <option value="Uang Harian">Uang Harian / Saku</option>
                                    <option value="Lain-lain">Lain-lain</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Keterangan / Keperluan</label>
                                <textarea class="form-control" id="keterangan" rows="2" placeholder="Contoh: Taksi ke bandara" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Jumlah (Rp)</label>
                                <input type="number" class="form-control" id="jumlah" placeholder="Contoh: 150000" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2" id="btnSimpan">
                                <i class="fas fa-save me-1"></i> Simpan Pengeluaran
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Tabel Rekapan -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-list me-2 text-primary"></i>Riwayat Pengeluaran</h5>
                        <button class="btn btn-sm btn-outline-secondary" onclick="loadData()"><i class="fas fa-sync-alt"></i> Refresh</button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Kota</th>
                                        <th>Kategori</th>
                                        <th>Keterangan</th>
                                        <th class="text-end">Jumlah</th>
                                        <th class="text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="tabelBody">
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Memuat data dari Google Sheets...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Atur Uang Muka -->
    <div class="modal fade" id="modalUangMuka" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fas fa-money-bill-wave me-2 text-info"></i>Atur Total Uang Muka</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formUangMuka">
                        <div class="mb-3">
                            <label class="form-label">Nominal Total Uang Muka Baru (Rp)</label>
                            <input type="number" class="form-control" id="inputUangMuka" placeholder="Contoh: 5000000" required>
                        </div>
                        <button type="submit" class="btn btn-info text-white w-100" id="btnSimpanUM">Simpan Perubahan</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Tambah Uang Muka -->
    <div class="modal fade" id="modalTambahUangMuka" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2 text-info"></i>Tambah Nilai Uang Muka</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formTambahUangMuka">
                        <div class="mb-3">
                            <label class="form-label">Nominal Tambahan dari Bendahara (Rp)</label>
                            <input type="number" class="form-control" id="inputTambahUM" placeholder="Contoh: 1000000" required>
                        </div>
                        <button type="submit" class="btn btn-info text-white w-100" id="btnTambahUM">Tambahkan Dana</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script Koneksi Apps Script -->
    <script>
        // GANTI DENGAN URL WEB APP GOOGLE APPS SCRIPT ANDA
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbw8D8nwJ_vV1CJAn2NNrTlepYjeduSivChDlC4l1zhA-Xn2mjEzC90vi52Mp5pp5JZW/exec";

        let currentUangMuka = 0;

        document.addEventListener("DOMContentLoaded", function() {
            document.getElementById('tanggal').valueAsDate = new Date();
            loadData();
        });

        // Simpan Pengeluaran Baru
        document.getElementById("formDinas").addEventListener("submit", function(e) {
            e.preventDefault();
            const btn = document.getElementById("btnSimpan");
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Menyimpan...';

            const payload = {
                action: "simpanPengeluaran",
                tanggal: document.getElementById("tanggal").value,
                kota: document.getElementById("kota").value,
                kategori: document.getElementById("kategori").value,
                keterangan: document.getElementById("keterangan").value,
                jumlah: Number(document.getElementById("jumlah").value)
            };

            fetch(SCRIPT_URL, {
                method: "POST",
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(res => {
                if(res.status === "success") {
                    document.getElementById("formDinas").reset();
                    document.getElementById('tanggal').valueAsDate = new Date();
                    loadData();
                } else {
                    alert("Gagal: " + res.message);
                }
            })
            .catch(err => alert("Koneksi error: " + err))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-1"></i> Simpan Pengeluaran';
            });
        });

        // Set Ulang Total Uang Muka
        document.getElementById("formUangMuka").addEventListener("submit", function(e) {
            e.preventDefault();
            const val = Number(document.getElementById("inputUangMuka").value);
            updateUangMukaServer(val, "modalUangMuka");
        });

        // Tambah Uang Muka (Akumulasi)
        document.getElementById("formTambahUangMuka").addEventListener("submit", function(e) {
            e.preventDefault();
            const tambahan = Number(document.getElementById("inputTambahUM").value);
            const totalBaru = currentUangMuka + tambahan;
            document.getElementById("formTambahUangMuka").reset();
            updateUangMukaServer(totalBaru, "modalTambahUangMuka");
        });

        function updateUangMukaServer(newVal, modalId) {
            const payload = {
                action: "updateUangMuka",
                uangMuka: newVal
            };

            fetch(SCRIPT_URL, {
                method: "POST",
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(res => {
                if(res.status === "success") {
                    bootstrap.Modal.getInstance(document.getElementById(modalId)).hide();
                    loadData();
                } else {
                    alert("Gagal memperbarui uang muka");
                }
            })
            .catch(err => alert("Koneksi error: " + err));
        }

        // Muat Data dari Google Sheets
        function loadData() {
            fetch(SCRIPT_URL + "?action=getData")
            .then(res => res.json())
            .then(res => {
                if(res.status === "success") {
                    currentUangMuka = Number(res.uangMuka || 0);
                    document.getElementById("inputUangMuka").value = currentUangMuka;
                    renderTable(res.data, currentUangMuka);
                }
            })
            .catch(err => console.error("Gagal memuat data:", err));
        }

        function renderTable(data, uangMuka) {
            const tbody = document.getElementById("tabelBody");
            tbody.innerHTML = "";
            
            let totalBiaya = 0;
            let totalTx = data.length;

            if(totalTx === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted py-4">Belum ada pengeluaran dicatat.</td></tr>`;
            } else {
                data.forEach(item => {
                    totalBiaya += Number(item.jumlah || 0);
                    
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td>${item.tanggal ? String(item.tanggal).substring(0, 10) : '-'}</td>
                        <td><span class="badge bg-light text-dark border">${item.kota}</span></td>
                        <td><span class="badge bg-secondary">${item.kategori}</span></td>
                        <td>${item.keterangan}</td>
                        <td class="text-end fw-semibold">Rp ${Number(item.jumlah).toLocaleString('id-ID')}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-danger" onclick="hapusItem('${item.id}')" title="Hapus"><i class="fas fa-trash"></i></button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            // Hitung Sisa Saldo / Kurang Bayar
            let sisa = uangMuka - totalBiaya;

            document.getElementById("labelUangMuka").innerText = "Rp " + uangMuka.toLocaleString('id-ID');
            document.getElementById("totalPengeluaran").innerText = "Rp " + totalBiaya.toLocaleString('id-ID');
            
            const sisaElem = document.getElementById("sisaSaldo");
            const cardContainer = document.getElementById("cardSisaContainer");
            const labelSisa = document.getElementById("labelSisaTitle");

            sisaElem.innerText = "Rp " + Math.abs(sisa).toLocaleString('id-ID');

            if(sisa >= 0) {
                cardContainer.className = "card shadow-sm border-0 bg-success text-white";
                labelSisa.innerText = "Sisa Saldo (Kembalian)";
            } else {
                cardContainer.className = "card shadow-sm border-0 bg-danger text-white";
                labelSisa.innerText = "Kurang Bayar (Tombok)";
            }
        }

        // Hapus Data
        function hapusItem(id) {
            if(confirm("Yakin ingin menghapus pengeluaran ini?")) {
                const payload = {
                    action: "hapusPengeluaran",
                    id: id
                };

                fetch(SCRIPT_URL, {
                    method: "POST",
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(res => {
                    if(res.status === "success") {
                        loadData();
                    } else {
                        alert("Gagal menghapus data");
                    }
                })
                .catch(err => alert("Koneksi error: " + err));
            }
        }
    </script>
</body>
</html>
